{
  "name": "@pulsate/exp-api-types",
  "version": "0.1.2",
  "exports": "./src/index.ts",
  "nodeModulesDir": "auto",
  "publish": {
    "include": ["LICENSE", "README.md", "src/**/*.ts"]
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.42.3",
    "@pulsate-dev/api-schema": "npm:@pulsate-dev/api-schema@0.1.0/schema.json"
  },
  "tasks": {
    "prepare-schema": "deno run --allow-read --allow-write scripts/prepare-schema.ts",
    "build": "deno task prepare-schema && deno run -A npm:@hey-api/openapi-ts@0.99.0",
    "build-npm": "deno task build && deno run -A scripts/build-npm.ts"
  }
}
