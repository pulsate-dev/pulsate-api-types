{
  "name": "@pulsate-dev/exp-api-types",
  "version": "0.1.2",
  "description": "TypeScript types and Fetch API client for Pulsate (Experimental)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pulsate-dev/pulsate-api-types.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "prepare-schema": "node scripts/prepare-schema.ts",
    "generate": "pnpm prepare-schema && openapi-ts",
    "build": "pnpm generate && tsc -p tsconfig.build.json"
  },
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@pulsate-dev/api-schema": "0.1.0",
    "typescript": "5.9.3"
  }
}
